<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Tier List Export</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        h1 {
            text-align: center;
            color: #333;
        }
        .tier-category {
            margin-bottom: 30px;
            padding: 15px;
            border-radius: 8px;
            page-break-inside: avoid;
        }
        .tier-category.tier-s {
            background-color: #ff6b6b;
        }
        .tier-category.tier-a {
            background-color: #4ecdc4;
        }
        .tier-category.tier-b {
            background-color: #45b7d1;
        }
        .tier-category.tier-c {
            background-color: #f9ca24;
        }
        .tier-category.tier-d {
            background-color: #95a5a6;
        }
        .tier-category h2 {
            margin-top: 0;
            color: white;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
        }
        .tier-logos {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        .logo-item {
            background: white;
            padding: 10px;
            border-radius: 4px;
            text-align: center;
        }
        .logo-item img {
            max-width: 100%;
            height: auto;
            max-height: 80px;
            object-fit: contain;
        }
        .logo-item p {
            margin: 5px 0 0 0;
            font-size: 12px;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <h1>Tier List Export</h1>

    {% if logosByCategory.S is not empty %}
        <div class="tier-category tier-s">
            <h2>S - Les chefs-d'œuvre du branding</h2>
            <div class="tier-logos">
                {% for logo in logosByCategory.S %}
                    <div class="logo-item">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if logosByCategory.A is not empty %}
        <div class="tier-category tier-a">
            <h2>A - Excellents logos</h2>
            <div class="tier-logos">
                {% for logo in logosByCategory.A %}
                    <div class="logo-item">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if logosByCategory.B is not empty %}
        <div class="tier-category tier-b">
            <h2>B - Bons logos</h2>
            <div class="tier-logos">
                {% for logo in logosByCategory.B %}
                    <div class="logo-item">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if logosByCategory.C is not empty %}
        <div class="tier-category tier-c">
            <h2>C - Logos moyens</h2>
            <div class="tier-logos">
                {% for logo in logosByCategory.C %}
                    <div class="logo-item">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if logosByCategory.D is not empty %}
        <div class="tier-category tier-d">
            <h2>D - Logos à améliorer</h2>
            <div class="tier-logos">
                {% for logo in logosByCategory.D %}
                    <div class="logo-item">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</body>
</html>

