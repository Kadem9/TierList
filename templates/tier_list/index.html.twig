                        </form>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# Section D - Logos à améliorer #}
        <div class="tier-row tier-d">
            <div class="tier-label">D</div>
            <div class="tier-logos">
                {% for logo in logosByCategory.D %}
                    <div class="logo-item" data-logo-id="{{ logo.id }}">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                        <form method="POST" action="{{ path('tier_list_move') }}" class="move-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('tier_list_move') }}" />
                            <input type="hidden" name="logoId" value="{{ logo.id }}" />
                            <select name="category" class="category-select">
                                <option value="">Choisir une catégorie</option>
                                <option value="S">S - Les chefs-d'œuvre du branding</option>
                                <option value="A">A - Excellents logos</option>
                                <option value="B">B - Bons logos</option>
                                <option value="C">C - Logos moyens</option>
                                <option value="D" selected>D - Logos à améliorer</option>
                            </select>
                            <button type="submit" class="btn-move">Déplacer</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Banque de logos non classés #}
    <div class="logo-bank">
        <h2>Banque de logos</h2>
        <div class="logo-bank-grid">
            {% for logo in unclassifiedLogos %}
                <div class="logo-item" data-logo-id="{{ logo.id }}">
                    <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                    <p>{{ logo.name }}</p>
                    <form method="POST" action="{{ path('tier_list_move') }}" class="move-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('tier_list_move') }}" />
                        <input type="hidden" name="logoId" value="{{ logo.id }}" />
                        <select name="category" class="category-select">
                            <option value="">Choisir une catégorie</option>
                            <option value="S">S - Les chefs-d'œuvre du branding</option>
                            <option value="A">A - Excellents logos</option>
                            <option value="B">B - Bons logos</option>
                            <option value="C">C - Logos moyens</option>
                            <option value="D">D - Logos à améliorer</option>
                        </select>
                        <button type="submit" class="btn-move">Déplacer</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
