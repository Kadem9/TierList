{% extends 'base.html.twig' %}

{% block title %}Tier List{% endblock %}

{% block body %}
<div class="tier-list-container">
    <nav class="tier-list-nav">
        <span class="nav-brand">TierList</span>
        <div class="nav-links">
            <a href="{{ path('profile_index') }}" class="nav-link">Mon Profil</a>
            <a href="{{ path('logout') }}" class="nav-link nav-logout">Déconnexion</a>
        </div>
    </nav>

    <div class="tier-list-header">
        <h1>Tier List</h1>
        <div class="header-actions">
            {% if not isPremium %}
                <a href="{{ path('payment_subscribe') }}" class="btn-unlock">Débloquer la Tier List</a>
            {% endif %}
            <a href="{{ path('tier_list_export') }}" class="btn-export-pdf">Exporter en PDF</a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}

    {% if isPremium %}
        <p class="drag-hint">Glissez-déposez les logos pour les classer</p>
    {% endif %}

    <div class="tier-list-grid">
        {% for tier, tierLabel in {'S': 'Chefs-d\'œuvre', 'A': 'Excellents', 'B': 'Bons', 'C': 'Moyens', 'D': 'À améliorer'} %}
        <div class="tier-row tier-{{ tier|lower }}" data-tier="{{ tier }}">
            <div class="tier-label">{{ tier }}</div>
            <div class="tier-logos">
                {% for logo in logosByCategory[tier] %}
                    <div class="logo-item" data-logo-id="{{ logo.id }}">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <span class="logo-name">{{ logo.name }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="logo-bank" data-tier="bank">
        <h2>Banque de logos</h2>
        {% if not isPremium %}
            <p class="premium-notice">
                <a href="{{ path('payment_subscribe') }}">Passez Premium</a> pour classer vos logos
            </p>
        {% endif %}
        <div class="logo-bank-grid">
            {% for logo in unclassifiedLogos %}
                <div class="logo-item" data-logo-id="{{ logo.id }}">
                    <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                    <span class="logo-name">{{ logo.name }}</span>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/tierlist-dragdrop.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            new TierListDragDrop({
                csrfToken: '{{ csrf_token('tier_list_move') }}',
                moveUrl: '{{ path('tier_list_move') }}',
                isPremium: {{ isPremium ? 'true' : 'false' }}
            });
        });
    </script>
{% endblock %}
