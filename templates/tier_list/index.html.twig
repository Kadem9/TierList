{% extends 'base.html.twig' %}

{% block title %}Ma Tier List - TierList{% endblock %}

{% block body %}
<div class="tierlist">
    <div class="tierlist__conteneur">
        <nav class="tierlist__navigation">
            <span class="tierlist__marque">TierList</span>
            <div class="tierlist__liens-nav">
                <a href="{{ path('profile_index') }}" class="tierlist__lien-nav">
                    Mon Profil
                </a>
                <a href="{{ path('logout') }}" class="tierlist__lien-nav tierlist__lien-nav--deconnexion">
                    Déconnexion
                </a>
            </div>
        </nav>

        <header class="tierlist__entete">
            <div class="tierlist__titre-section">
                <h1 class="tierlist__titre">Ma Tier List</h1>
                <p class="tierlist__description">Classez vos logos préférés de S (meilleur) à D (à améliorer)</p>
            </div>
            <div class="tierlist__actions">
                {% if not isPremium %}
                    <a href="{{ path('payment_subscribe') }}" class="tierlist__bouton-premium">
                        Passer Premium
                    </a>
                {% endif %}
                <a href="{{ path('tier_list_export') }}" class="tierlist__bouton-export">
                    Exporter PDF
                </a>
            </div>
        </header>

        {% for message in app.flashes('success') %}
            <div class="tierlist__alerte tierlist__alerte--succes">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="tierlist__alerte tierlist__alerte--erreur">{{ message }}</div>
        {% endfor %}

        {% if isPremium %}
            <div class="tierlist__indication-drag">
                Glissez-déposez les logos pour les classer dans les différentes catégories
            </div>
        {% endif %}

        <div class="tierlist__grille">
            {% for tier, tierLabel in {
                'S': 'Chefs-d\'œuvre',
                'A': 'Excellents',
                'B': 'Bons',
                'C': 'Moyens',
                'D': 'À améliorer'
            } %}
            <div class="tierlist__rangee tierlist__rangee--tier-{{ tier|lower }}" data-tier="{{ tier }}">
                <div class="tierlist__etiquette-tier">{{ tier }}</div>
                <div class="tierlist__zone-logos" data-drop-zone="{{ tier }}">
                    {% for logo in logosByCategory[tier] %}
                        <div class="logo-carte" data-logo-id="{{ logo.id }}">
                            <img src="{{ logo.url }}" alt="{{ logo.name }}" class="logo-carte__image" />
                            <span class="logo-carte__nom">{{ logo.name }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>

        <section class="tierlist__banque" data-tier="bank">
            <header class="tierlist__banque-entete">
                <h2 class="tierlist__banque-titre">Banque de logos</h2>
                <span class="tierlist__banque-compteur">{{ unclassifiedLogos|length }} logos</span>
            </header>
            
            {% if not isPremium %}
                <div class="tierlist__notice-premium">
                    <a href="{{ path('payment_subscribe') }}">Passez Premium</a> pour classer vos logos par glisser-déposer
                </div>
            {% endif %}
            
            <div class="tierlist__banque-grille" data-drop-zone="bank">
                {% for logo in unclassifiedLogos %}
                    <div class="logo-carte" data-logo-id="{{ logo.id }}">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" class="logo-carte__image" />
                        <span class="logo-carte__nom">{{ logo.name }}</span>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>
    
    <div class="notification-drag" id="notification-drag"></div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/tierlist-dragdrop.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            new TierListDragDrop({
                csrfToken: '{{ csrf_token('tier_list_move') }}',
                moveUrl: '{{ path('tier_list_move') }}',
                isPremium: {{ isPremium ? 'true' : 'false' }},
                logoSelector: '.logo-carte',
                dropZoneSelector: '[data-drop-zone]',
                draggingClass: 'logo-carte--en-deplacement',
                activeZoneClass: 'tierlist__zone-logos--actif',
                activeBankClass: 'tierlist__banque-grille--actif',
                notificationElement: '#notification-drag',
                notificationVisibleClass: 'notification-drag--visible',
                notificationSuccessClass: 'notification-drag--succes',
                notificationErrorClass: 'notification-drag--erreur'
            });
        });
    </script>
{% endblock %}
