{% extends 'base.html.twig' %}

{% block title %}Tier List{% endblock %}

{% block body %}
<div class="tier-list-container">
    <div class="tier-list-header">
        <h1>Tier List</h1>
        <div class="header-actions">
            {% if not isPremium %}
                <a href="{{ path('payment_subscribe') }}" class="btn-unlock">Débloquer la Tier List</a>
            {% endif %}
            <a href="{{ path('tier_list_export') }}" class="btn-export-pdf">Exporter en PDF</a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}

    {# Grille avec 5 lignes colorées (S, A, B, C, D) #}
    <div class="tier-list-grid">
        {% for tier, tierLabel in {'S': 'Chefs-d\'œuvre', 'A': 'Excellents', 'B': 'Bons', 'C': 'Moyens', 'D': 'À améliorer'} %}
        <div class="tier-row tier-{{ tier|lower }}">
            <div class="tier-label">{{ tier }}</div>
            <div class="tier-logos">
                {% for logo in logosByCategory[tier] %}
                    <div class="logo-item" data-logo-id="{{ logo.id }}">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                        {% if isPremium %}
                            <form method="POST" action="{{ path('tier_list_move') }}" class="move-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('tier_list_move') }}" />
                                <input type="hidden" name="logoId" value="{{ logo.id }}" />
                                <select name="category" class="category-select">
                                    <option value="">Choisir</option>
                                    <option value="S" {{ tier == 'S' ? 'selected' : '' }}>S</option>
                                    <option value="A" {{ tier == 'A' ? 'selected' : '' }}>A</option>
                                    <option value="B" {{ tier == 'B' ? 'selected' : '' }}>B</option>
                                    <option value="C" {{ tier == 'C' ? 'selected' : '' }}>C</option>
                                    <option value="D" {{ tier == 'D' ? 'selected' : '' }}>D</option>
                                </select>
                                <button type="submit" class="btn-move">Déplacer</button>
                            </form>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="logo-bank">
        <h2>Banque de logos</h2>
        {% if not isPremium %}
            <p class="premium-notice">
                <a href="{{ path('payment_subscribe') }}">Passez Premium</a> pour classer vos logos
            </p>
        {% endif %}
        <div class="logo-bank-grid">
            {% for logo in unclassifiedLogos %}
                <div class="logo-item" data-logo-id="{{ logo.id }}">
                    <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                    <p>{{ logo.name }}</p>
                    {% if isPremium %}
                        <form method="POST" action="{{ path('tier_list_move') }}" class="move-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('tier_list_move') }}" />
                            <input type="hidden" name="logoId" value="{{ logo.id }}" />
                            <select name="category" class="category-select">
                                <option value="">Choisir</option>
                                <option value="S">S</option>
                                <option value="A">A</option>
                                <option value="B">B</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                            </select>
                            <button type="submit" class="btn-move">Déplacer</button>
                        </form>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
