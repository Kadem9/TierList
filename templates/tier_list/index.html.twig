{% extends 'base.html.twig' %}

{% block title %}Tier List{% endblock %}

{% block body %}
<div class="tier-list-container">
    <div class="tier-list-header">
        <h1>Tier List</h1>
        <a href="{{ path('tier_list_export') }}" class="btn-export-pdf">Exporter en PDF</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}

    {# Grille avec 5 lignes colorées (S, A, B, C, D) #}
    <div class="tier-list-grid">
        {# Section S - Chefs-d'œuvre #}
        <div class="tier-row tier-s">
            <div class="tier-label">S</div>
            <div class="tier-logos">
                {% for logo in logosByCategory.S %}
                    <div class="logo-item" data-logo-id="{{ logo.id }}">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                        <form method="POST" action="{{ path('tier_list_move') }}" class="move-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('tier_list_move') }}" />
                            <input type="hidden" name="logoId" value="{{ logo.id }}" />
                            <select name="category" class="category-select">
                                <option value="">Choisir une catégorie</option>
                                <option value="S" selected>S - Les chefs-d'œuvre du branding</option>
                                <option value="A">A - Excellents logos</option>
                                <option value="B">B - Bons logos</option>
                                <option value="C">C - Logos moyens</option>
                                <option value="D">D - Logos à améliorer</option>
                            </select>
                            <button type="submit" class="btn-move">Déplacer</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# Section A - Excellents logos #}
        <div class="tier-row tier-a">
            <div class="tier-label">A</div>
            <div class="tier-logos">
                {% for logo in logosByCategory.A %}
                    <div class="logo-item" data-logo-id="{{ logo.id }}">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                        <form method="POST" action="{{ path('tier_list_move') }}" class="move-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('tier_list_move') }}" />
                            <input type="hidden" name="logoId" value="{{ logo.id }}" />
                            <select name="category" class="category-select">
                                <option value="">Choisir une catégorie</option>
                                <option value="S">S - Les chefs-d'œuvre du branding</option>
                                <option value="A" selected>A - Excellents logos</option>
                                <option value="B">B - Bons logos</option>
                                <option value="C">C - Logos moyens</option>
                                <option value="D">D - Logos à améliorer</option>
                            </select>
                            <button type="submit" class="btn-move">Déplacer</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# Section B - Bons logos #}
        <div class="tier-row tier-b">
            <div class="tier-label">B</div>
            <div class="tier-logos">
                {% for logo in logosByCategory.B %}
                    <div class="logo-item" data-logo-id="{{ logo.id }}">
                        <img src="{{ logo.url }}" alt="{{ logo.name }}" />
                        <p>{{ logo.name }}</p>
                        <form method="POST" action="{{ path('tier_list_move') }}" class="move-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('tier_list_move') }}" />
                            <input type="hidden" name="logoId" value="{{ logo.id }}" />
